{
  "name": "varuna-chronicles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "原環の大地 ― ヴァルナ年代記 ―：古代生物が主役のオープンワールドARPGの設計書と垂直スライス",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node tools/make-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/smoke-test.mjs",
    "deploy": "npm run build && node tools/deploy-pages.mjs",
    "verify": "npm test && node tools/actions.mjs && node tools/quests.mjs && node tools/orga.mjs && node tools/gamepad.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "playwright": "^1.55.1",
    "puppeteer-core": "^25.11.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.3.6"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
